{
  "name": "@nuvek/ui",
  "version": "0.1.1",
  "description": "Shared nuvek design system — CSS tokens, base styles, and Vue 3 components.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nuvek-ui.umd.cjs",
  "module": "./dist/nuvek-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nuvek-ui.js",
      "require": "./dist/nuvek-ui.umd.cjs"
    },
    "./style.css": "./dist/nuvek-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  }
}
